{
  "name": "binger",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace @binger/api & npm run dev --workspace @binger/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @binger/api",
    "db:seed": "npm run db:seed --workspace @binger/api"
  },
  "engines": { "node": ">=20" }
}
