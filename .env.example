NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://binger:binger_dev@localhost:5432/binger?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-an-independent-random-secret
EMAIL_TOKEN_SECRET=replace-with-an-independent-32-character-secret
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
DEV_EXPOSE_EMAIL_TOKENS=false
# Em produção, configure um caminho absoluto exclusivo da API, fora do checkout e do Caddy/Nginx.
# Sem esta variável em desenvolvimento, a API usa um diretório temporário privado do sistema.
# PRIVATE_MEDIA_ROOT=/var/lib/binger-private-media
PRIVATE_MEDIA_MAX_BYTES=262144
PRIVATE_MEDIA_MAX_WIDTH=1600
PRIVATE_MEDIA_MAX_HEIGHT=1600
PRIVATE_MEDIA_MAX_PIXELS=2560000
PRIVATE_MEDIA_RETENTION_HOURS=24
PRIVATE_MESSAGE_DELETE_WINDOW_MINUTES=15
PRIVATE_MEDIA_USER_LIMIT=6
PRIVATE_MEDIA_CONVERSATION_LIMIT=12
PRIVATE_MEDIA_IP_LIMIT=10
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=replace-with-a-strong-password
VITE_API_URL=http://localhost:3001
